{
  "name": "dinemate-ai-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DineMate AI – React + JSON Server (CRUD) version of the Part 1 HTML/CSS/JS module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c magenta,cyan \"npm:client\" \"npm:server\"",
    "client": "vite",
