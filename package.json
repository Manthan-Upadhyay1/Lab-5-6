    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "gh-pages": "^6.3.0",
    "json-server": "^0.17.4",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
